{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.trex.movement": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": ["idle"],
          "transitions": [
            {
              "sitting": "query.property('jurassic:is_sitting')"
            },
            {
              "walk": "query.modified_move_speed > 0.01"
            }
          ],
          "blend_transition": 0.2
        },
        "walk": {
          "animations": ["walk"],
          "transitions": [
            {
              "sitting": "query.property('jurassic:is_sitting')"
            },
            {
              "idle": "query.modified_move_speed <= 0.01"
            },
            {
              "run": "query.modified_move_speed > 0.45"
            }
          ],
          "blend_transition": 0.15
        },
        "run": {
          "animations": ["run"],
          "transitions": [
            {
              "sitting": "query.property('jurassic:is_sitting')"
            },
            {
              "idle": "query.modified_move_speed <= 0.01"
            },
            {
              "walk": "query.modified_move_speed <= 0.45"
            }
          ],
          "blend_transition": 0.1
        },
        "sitting": {
          "animations": ["sit"],
          "transitions": [
            {
              "idle": "!query.property('jurassic:is_sitting')"
            }
          ],
          "blend_transition": 0.25
        }
      }
    }
  }
}
